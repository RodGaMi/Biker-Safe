rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTagId(id) {
      return id is string && id.size() >= 4 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPkgId(id) {
      return id is string && id.size() >= 2 && id.size() <= 32 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'gami.rodrigo@gmail.com';
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll([
        'ownerId',
        'displayName',
        'email',
        'personalPhone',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'displayName',
        'email',
        'personalPhone',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.personalPhone is string && data.personalPhone.size() >= 0 && data.personalPhone.size() <= 30 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidEmergencySticker(data) {
      return data.keys().hasAll([
        'tagId',
        'ownerId',
        'fullName',
        'bloodType',
        'allergies',
        'medicalConditions',
        'emergencyContactName',
        'emergencyContactRelation',
        'emergencyContactPhone',
        'secondaryContactName',
        'secondaryContactRelation',
        'secondaryContactPhone',
        'motorcycleDetails',
        'insuranceDetails',
        'organDonor',
        'isActive',
        'accessPin',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'tagId',
        'ownerId',
        'fullName',
        'bloodType',
        'allergies',
        'medicalConditions',
        'emergencyContactName',
        'emergencyContactRelation',
        'emergencyContactPhone',
        'secondaryContactName',
        'secondaryContactRelation',
        'secondaryContactPhone',
        'motorcycleDetails',
        'insuranceDetails',
        'organDonor',
        'isActive',
        'accessPin',
        'createdAt',
        'updatedAt'
      ]) &&
      data.tagId is string && data.tagId.size() >= 4 && data.tagId.size() <= 64 && data.tagId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      data.bloodType is string && data.bloodType.size() >= 2 && data.bloodType.size() <= 15 &&
      data.bloodType in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'Desconocido'] &&
      data.allergies is string && data.allergies.size() >= 0 && data.allergies.size() <= 500 &&
      data.medicalConditions is string && data.medicalConditions.size() >= 0 && data.medicalConditions.size() <= 1000 &&
      data.emergencyContactName is string && data.emergencyContactName.size() >= 2 && data.emergencyContactName.size() <= 100 &&
      data.emergencyContactRelation is string && data.emergencyContactRelation.size() >= 1 && data.emergencyContactRelation.size() <= 50 &&
      data.emergencyContactPhone is string && data.emergencyContactPhone.size() >= 5 && data.emergencyContactPhone.size() <= 30 && data.emergencyContactPhone.matches('^[0-9+\\-()\\s]+$') &&
      data.secondaryContactName is string && data.secondaryContactName.size() >= 0 && data.secondaryContactName.size() <= 100 &&
      data.secondaryContactRelation is string && data.secondaryContactRelation.size() >= 0 && data.secondaryContactRelation.size() <= 50 &&
      data.secondaryContactPhone is string && data.secondaryContactPhone.size() >= 0 && data.secondaryContactPhone.size() <= 30 && (data.secondaryContactPhone.size() == 0 || data.secondaryContactPhone.matches('^[0-9+\\-()\\s]+$')) &&
      data.motorcycleDetails is string && data.motorcycleDetails.size() >= 0 && data.motorcycleDetails.size() <= 150 &&
      data.insuranceDetails is string && data.insuranceDetails.size() >= 0 && data.insuranceDetails.size() <= 150 &&
      data.organDonor is bool &&
      data.isActive is bool &&
      data.accessPin is string && data.accessPin.size() >= 0 && data.accessPin.size() <= 10 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidScanLog(data) {
      return data.keys().hasAll([
        'scanId',
        'tagId',
        'stickerOwnerId',
        'scannerUid',
        'scannerLabel',
        'scanMethod',
        'locationNote',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'scanId',
        'tagId',
        'stickerOwnerId',
        'scannerUid',
        'scannerLabel',
        'scanMethod',
        'locationNote',
        'createdAt'
      ]) &&
      data.scanId is string && data.scanId.size() >= 4 && data.scanId.size() <= 64 && data.scanId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.tagId is string && data.tagId.size() >= 4 && data.tagId.size() <= 64 && data.tagId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.stickerOwnerId is string && data.stickerOwnerId.size() >= 1 && data.stickerOwnerId.size() <= 128 && data.stickerOwnerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.scannerUid is string && data.scannerUid.size() >= 1 && data.scannerUid.size() <= 128 && data.scannerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.scannerUid == request.auth.uid &&
      data.scannerLabel is string && data.scannerLabel.size() >= 1 && data.scannerLabel.size() <= 120 &&
      data.scanMethod is string && data.scanMethod.size() >= 6 && data.scanMethod.size() <= 20 &&
      data.scanMethod in ['NFC_TAG', 'QR_CODE', 'DIRECT_URL', 'SIMULATOR'] &&
      data.locationNote is string && data.locationNote.size() >= 0 && data.locationNote.size() <= 200 &&
      data.createdAt is timestamp;
    }

    function isValidStickerPackageOption(data) {
      return data.keys().hasAll([
        'pkgId',
        'name',
        'subtitle',
        'price',
        'specs',
        'stickerCount',
        'availableColors',
        'sortOrder',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'pkgId',
        'name',
        'subtitle',
        'price',
        'specs',
        'stickerCount',
        'availableColors',
        'availableModels',
        'sortOrder',
        'updatedAt'
      ]) &&
      (!('availableModels' in data) || (
        data.availableModels is list &&
        data.availableModels.size() >= 1 &&
        data.availableModels.size() <= 3 &&
        data.availableModels[0] is string &&
        data.availableModels[0].size() >= 3 &&
        data.availableModels[0].size() <= 20 &&
        data.availableModels.hasOnly(['Racer', 'Choper', 'Cross'])
      )) &&
      data.pkgId is string && data.pkgId.size() >= 2 && data.pkgId.size() <= 32 && data.pkgId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 80 &&
      data.price is number && data.price >= 1 && data.price <= 100000 &&
      data.specs is string && data.specs.size() >= 2 && data.specs.size() <= 250 &&
      data.stickerCount is number && data.stickerCount >= 1 && data.stickerCount <= 10 &&
      data.availableColors is list &&
      data.availableColors.size() >= 1 &&
      data.availableColors.size() <= 8 &&
      data.availableColors[0] is string &&
      data.availableColors[0].size() >= 3 &&
      data.availableColors[0].size() <= 20 &&
      data.availableColors.hasOnly(['Rojo', 'Negro', 'Gris', 'Verde', 'Azul', 'Rosa', 'Morado', 'Amarillo']) &&
      data.sortOrder is number && data.sortOrder >= 1 && data.sortOrder <= 10 &&
      data.updatedAt is timestamp;
    }

    function isValidStickerModelCatalog(data) {
      return data.keys().hasAll([
        'modelId',
        'name',
        'description',
        'referenceImageUrl',
        'imageRojo',
        'imageNegro',
        'imageGris',
        'imageVerde',
        'imageAzul',
        'imageRosa',
        'imageMorado',
        'imageAmarillo',
        'sortOrder',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'modelId',
        'name',
        'description',
        'referenceImageUrl',
        'imageRojo',
        'imageNegro',
        'imageGris',
        'imageVerde',
        'imageAzul',
        'imageRosa',
        'imageMorado',
        'imageAmarillo',
        'sortOrder',
        'updatedAt'
      ]) &&
      data.modelId is string && data.modelId.size() >= 2 && data.modelId.size() <= 20 && data.modelId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.modelId in ['racer', 'choper', 'cross'] &&
      data.name is string && data.name.size() >= 3 && data.name.size() <= 20 &&
      data.name in ['Racer', 'Choper', 'Cross'] &&
      data.description is string && data.description.size() >= 0 && data.description.size() <= 200 &&
      data.referenceImageUrl is string && data.referenceImageUrl.size() >= 0 && data.referenceImageUrl.size() <= 350000 &&
      data.imageRojo is string && data.imageRojo.size() >= 0 && data.imageRojo.size() <= 250000 &&
      data.imageNegro is string && data.imageNegro.size() >= 0 && data.imageNegro.size() <= 250000 &&
      data.imageGris is string && data.imageGris.size() >= 0 && data.imageGris.size() <= 250000 &&
      data.imageVerde is string && data.imageVerde.size() >= 0 && data.imageVerde.size() <= 250000 &&
      data.imageAzul is string && data.imageAzul.size() >= 0 && data.imageAzul.size() <= 250000 &&
      data.imageRosa is string && data.imageRosa.size() >= 0 && data.imageRosa.size() <= 250000 &&
      data.imageMorado is string && data.imageMorado.size() >= 0 && data.imageMorado.size() <= 250000 &&
      data.imageAmarillo is string && data.imageAmarillo.size() >= 0 && data.imageAmarillo.size() <= 250000 &&
      data.sortOrder is number && data.sortOrder >= 1 && data.sortOrder <= 10 &&
      data.updatedAt is timestamp;
    }

    function isValidStickerOrder(data) {
      return data.keys().hasAll([
        'orderId',
        'tagId',
        'ownerId',
        'riderName',
        'pkgId',
        'pkgName',
        'stickerCount',
        'selectedColors',
        'totalPrice',
        'paymentMethod',
        'status',
        'recipientName',
        'recipientPhone',
        'shippingStreet',
        'shippingColony',
        'shippingCityState',
        'shippingPostalCode',
        'shippingNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderId',
        'tagId',
        'ownerId',
        'riderName',
        'pkgId',
        'pkgName',
        'stickerCount',
        'selectedModels',
        'selectedColors',
        'totalPrice',
        'paymentMethod',
        'deliveryMethod',
        'status',
        'recipientName',
        'recipientPhone',
        'shippingStreet',
        'shippingColony',
        'shippingCityState',
        'shippingPostalCode',
        'shippingNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      (!('selectedModels' in data) || (
        data.selectedModels is list &&
        data.selectedModels.size() >= 1 &&
        data.selectedModels.size() <= 10 &&
        data.selectedModels[0] is string &&
        data.selectedModels[0].size() >= 3 &&
        data.selectedModels[0].size() <= 20 &&
        data.selectedModels.hasOnly(['Racer', 'Choper', 'Cross'])
      )) &&
      (!('deliveryMethod' in data) || (
        data.deliveryMethod is string &&
        data.deliveryMethod.size() >= 5 &&
        data.deliveryMethod.size() <= 40 &&
        data.deliveryMethod in ['personal_cdmx_edomex', 'paqueteria_nacional']
      )) &&
      data.orderId is string && data.orderId.size() >= 4 && data.orderId.size() <= 64 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.tagId is string && data.tagId.size() >= 4 && data.tagId.size() <= 64 && data.tagId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      (data.ownerId == request.auth.uid || isAdmin()) &&
      data.riderName is string && data.riderName.size() >= 2 && data.riderName.size() <= 100 &&
      data.pkgId is string && data.pkgId.size() >= 2 && data.pkgId.size() <= 32 && data.pkgId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.pkgName is string && data.pkgName.size() >= 2 && data.pkgName.size() <= 80 &&
      data.stickerCount is number && data.stickerCount >= 1 && data.stickerCount <= 10 &&
      data.selectedColors is list &&
      data.selectedColors.size() >= 1 &&
      data.selectedColors.size() <= 10 &&
      data.selectedColors[0] is string &&
      data.selectedColors[0].size() >= 3 &&
      data.selectedColors[0].size() <= 20 &&
      data.selectedColors.hasOnly(['Rojo', 'Negro', 'Gris', 'Verde', 'Azul', 'Rosa', 'Morado', 'Amarillo']) &&
      data.totalPrice is number && data.totalPrice >= 1 && data.totalPrice <= 100000 &&
      data.paymentMethod is string && data.paymentMethod.size() >= 4 && data.paymentMethod.size() <= 30 &&
      data.paymentMethod in ['SPEI_WHATSAPP'] &&
      data.status is string && data.status.size() >= 4 && data.status.size() <= 30 &&
      data.status in ['pendiente_pago', 'pagado', 'tag_programado', 'enviado'] &&
      data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 100 &&
      data.recipientPhone is string && data.recipientPhone.size() >= 5 && data.recipientPhone.size() <= 30 && data.recipientPhone.matches('^[0-9+\\-()\\s]+$') &&
      data.shippingStreet is string && data.shippingStreet.size() >= 3 && data.shippingStreet.size() <= 200 &&
      data.shippingColony is string && data.shippingColony.size() >= 2 && data.shippingColony.size() <= 120 &&
      data.shippingCityState is string && data.shippingCityState.size() >= 2 && data.shippingCityState.size() <= 120 &&
      data.shippingPostalCode is string && data.shippingPostalCode.size() >= 3 && data.shippingPostalCode.size() <= 15 &&
      data.shippingNotes is string && data.shippingNotes.size() >= 0 && data.shippingNotes.size() <= 250 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPaymentSettings(data) {
      return data.keys().hasAll([
        'settingId',
        'bankName',
        'beneficiaryName',
        'clabe',
        'accountOrCard',
        'whatsappNumber',
        'paymentInstructions',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'settingId',
        'bankName',
        'beneficiaryName',
        'clabe',
        'accountOrCard',
        'whatsappNumber',
        'paymentInstructions',
        'brandLogoUrl',
        'updatedAt'
      ]) &&
      (!('brandLogoUrl' in data) || (
        data.brandLogoUrl is string &&
        data.brandLogoUrl.size() >= 0 &&
        data.brandLogoUrl.size() <= 750000
      )) &&
      data.settingId is string && data.settingId.size() >= 2 && data.settingId.size() <= 32 && data.settingId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 80 &&
      data.beneficiaryName is string && data.beneficiaryName.size() >= 2 && data.beneficiaryName.size() <= 120 &&
      data.clabe is string && data.clabe.size() >= 10 && data.clabe.size() <= 24 &&
      data.accountOrCard is string && data.accountOrCard.size() >= 0 && data.accountOrCard.size() <= 30 &&
      data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 25 && data.whatsappNumber.matches('^[0-9+\\-()\\s]+$') &&
      data.paymentInstructions is string && data.paymentInstructions.size() >= 0 && data.paymentInstructions.size() <= 350 &&
      data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /users/{userId}/private/{docId} (PII Split Collection)
    // =========================================================================
    match /users/{userId}/private/{docId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && isValidId(userId) && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'info' &&
        isOwner(userId) &&
        isValidUserPrivateInfo(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidId(docId) &&
        isValidUserPrivateInfo(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'personalPhone', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
    }

    // =========================================================================
    // Collection 2: /stickers/{tagId} (Emergency Medical NFC Stickers)
    // =========================================================================
    match /stickers/{tagId} {
      // Single-document lookup via unique physical NFC tagId works as a direct emergency landing page without login walls
      allow get: if isValidTagId(tagId) && (
        existing().isActive == true ||
        (isVerifiedUser() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );

      // List queries strictly enforced against resource.data without get()/exists() calls
      allow list: if isVerifiedUser() && (
        existing().ownerId == request.auth.uid ||
        existing().isActive == true ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidTagId(tagId) &&
        isValidEmergencySticker(incoming()) &&
        incoming().tagId == tagId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidTagId(tagId) &&
        isValidEmergencySticker(incoming()) &&
        incoming().tagId == existing().tagId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Full medical profile update by sticker owner
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'bloodType',
              'allergies',
              'medicalConditions',
              'emergencyContactName',
              'emergencyContactRelation',
              'emergencyContactPhone',
              'secondaryContactName',
              'secondaryContactRelation',
              'secondaryContactPhone',
              'motorcycleDetails',
              'insuranceDetails',
              'organDonor',
              'isActive',
              'accessPin',
              'updatedAt'
            ])
          ) ||
          // Action 2: Status toggle by sticker owner
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isActive',
              'emergencyContactRelation',
              'secondaryContactName',
              'secondaryContactRelation',
              'secondaryContactPhone',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidTagId(tagId) && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );

      // =======================================================================
      // Sub-collection 3: /stickers/{tagId}/scans/{scanId} (Audit Logs)
      // =======================================================================
      match /scans/{scanId} {
        allow get: if isVerifiedUser() && isValidTagId(tagId) && isValidTagId(scanId) && (
          existing().stickerOwnerId == request.auth.uid ||
          existing().scannerUid == request.auth.uid ||
          isAdmin()
        );

        allow list: if isVerifiedUser() && isValidTagId(tagId) && (
          existing().stickerOwnerId == request.auth.uid ||
          isAdmin()
        );

        allow create: if isVerifiedUser() &&
          isValidTagId(tagId) &&
          isValidTagId(scanId) &&
          isValidScanLog(incoming()) &&
          incoming().scanId == scanId &&
          incoming().tagId == tagId &&
          incoming().createdAt == request.time &&
          // Master Gate relational check against parent sticker
          exists(/databases/$(database)/documents/stickers/$(tagId)) &&
          get(/databases/$(database)/documents/stickers/$(tagId)).data.isActive == true &&
          incoming().stickerOwnerId == get(/databases/$(database)/documents/stickers/$(tagId)).data.ownerId;

        // Audit logs are immutable once recorded
        allow update: if false;

        allow delete: if isVerifiedUser() && isValidTagId(tagId) && isValidTagId(scanId) && (
          existing().stickerOwnerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // =========================================================================
    // Collection 4: /packages/{pkgId} (Configurable Purchase Options)
    // =========================================================================
    match /packages/{pkgId} {
      allow get: if isValidPkgId(pkgId);
      allow list: if existing().sortOrder >= 1;

      allow create: if isAdmin() &&
        isValidPkgId(pkgId) &&
        isValidStickerPackageOption(incoming()) &&
        incoming().pkgId == pkgId &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidPkgId(pkgId) &&
        isValidStickerPackageOption(incoming()) &&
        incoming().pkgId == existing().pkgId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'subtitle',
            'price',
            'specs',
            'stickerCount',
            'availableColors',
            'availableModels',
            'sortOrder',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidPkgId(pkgId);
    }

    // =========================================================================
    // Collection 4b: /sticker_models/{modelId} (Racer, Choper, Cross Reference Images)
    // =========================================================================
    match /sticker_models/{modelId} {
      allow get: if isValidPkgId(modelId);
      allow list: if existing().sortOrder >= 1;

      allow create: if isAdmin() &&
        isValidPkgId(modelId) &&
        isValidStickerModelCatalog(incoming()) &&
        incoming().modelId == modelId &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidPkgId(modelId) &&
        isValidStickerModelCatalog(incoming()) &&
        incoming().modelId == existing().modelId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'description',
            'referenceImageUrl',
            'imageRojo',
            'imageNegro',
            'imageGris',
            'imageVerde',
            'imageAzul',
            'imageRosa',
            'imageMorado',
            'imageAmarillo',
            'sortOrder',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidPkgId(modelId);
    }

    // =========================================================================
    // Collection 5: /orders/{orderId} (Customer NFC Sticker Orders)
    // =========================================================================
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidTagId(orderId) && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidTagId(orderId) &&
        isValidStickerOrder(incoming()) &&
        incoming().orderId == orderId &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'pendiente_pago' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/stickers/$(incoming().tagId)) &&
        get(/databases/$(database)/documents/stickers/$(incoming().tagId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser() &&
        isValidTagId(orderId) &&
        isValidStickerOrder(incoming()) &&
        incoming().orderId == existing().orderId &&
        incoming().tagId == existing().tagId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            existing().status == 'pendiente_pago' &&
            incoming().status == 'pendiente_pago' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'recipientName',
              'recipientPhone',
              'shippingStreet',
              'shippingColony',
              'shippingCityState',
              'shippingPostalCode',
              'shippingNotes',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidTagId(orderId) && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // Collection 6: /payment_settings/{settingId} (SPEI & WhatsApp Config)
    // =========================================================================
    match /payment_settings/{settingId} {
      allow get: if isValidPkgId(settingId);
      allow list: if existing().settingId == 'spei';

      allow create: if isAdmin() &&
        isValidPkgId(settingId) &&
        settingId == 'spei' &&
        isValidPaymentSettings(incoming()) &&
        incoming().settingId == settingId &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidPkgId(settingId) &&
        isValidPaymentSettings(incoming()) &&
        incoming().settingId == existing().settingId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'bankName',
            'beneficiaryName',
            'clabe',
            'accountOrCard',
            'whatsappNumber',
            'paymentInstructions',
            'brandLogoUrl',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidPkgId(settingId);
    }
  }
}
